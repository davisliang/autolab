#!/usr/bin/env bash
# Back-compat shim. Prefer ./start (new project) or ./resume (existing project).
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_DIR"

cat >&2 <<EOF
'./research' has been replaced by two clearer scripts:

    ./start  --idea "..."            # new project on a fresh idea
    ./resume --project <id>          # continue an existing project

Run \`./resume --list\` to see existing projects, or \`./start --help\`.
EOF

exit 2
