  "title": "Reward-Guided Speculative Decoding for Efficient LLM Reasoning",
  "submittedOnDailyBy": {
    "_id": "6602869253a0518b2a98cafd",
    "avatarUrl": "/avatars/c14b5953a716f42c83ad28147f8308ae.svg",
